# Default: let Git detect text files
* text=auto

# Scripts and source code should keep LF
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.m text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Windows PowerShell scripts can use CRLF
*.ps1 text eol=crlf

# Binary / data files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.tar.gz binary
*.npz binary
*.npy binary
*.mat binary
*.pt binary
*.pth binary
*.ckpt binary

# Frozen evidence and manuscript provenance are byte-hash validated.
# Preserve recorded line endings instead of normalizing these exported assets.
/downloads/** -text
/manuscript_langgraph/** -text
/output/pdf/** -text
/figures/** -text
/docs/** -text
/scripts/** -text
/release_metadata/** -text
/AGENTS.md -text
/eta_phase_diagram_cuda.py -text
/tfflo_1d_cuda.py -text
