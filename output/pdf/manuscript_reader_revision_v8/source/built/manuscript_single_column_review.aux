\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Physical hierarchy and adaptive scheduling.} Schematic illustration, not computed phase data: the altermagnetic and spin-orbit BdG model generates a normal-referenced $F_{\rm  impl}(\Delta ,q)$ landscape. Its reliable minimum determines Normal, uniform-SC, or FFLO order; only a gapped FFLO minimum proceeds to the Pfaffian test. The surrogate cycle proposes subsequent exact calls and does not determine either label.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:framework}{{1}{2}{\textbf {Physical hierarchy and adaptive scheduling.} Schematic illustration, not computed phase data: the altermagnetic and spin-orbit BdG model generates a normal-referenced $F_{\rm impl}(\Delta ,q)$ landscape. Its reliable minimum determines Normal, uniform-SC, or FFLO order; only a gapped FFLO minimum proceeds to the Pfaffian test. The surrogate cycle proposes subsequent exact calls and does not determine either label}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {}Results}{2}{section*.4}\protected@file@percent }
\newlabel{eq:minimum}{{1}{3}{}{equation.0.1}{}}
\newlabel{eq:invariant}{{2}{3}{}{equation.0.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Two-dimensional thermodynamic reconstruction.} \textbf  {(a)} Sparse exact initialization. \textbf  {(b)} Exact-call allocation across Stage I and its Stage-II continuation; darker red denotes later iterations (1--34), not a phase or probability. \textbf  {(c)} The 7,434-coordinate Stage-II endpoint, which contains the 6,880-coordinate Stage-I endpoint plus 554 additional exact coordinates; open symbols denote numerically flagged evaluations, not a phase. \textbf  {(d)} Numerical histories; dashed lines are the saved operational references described in the Supplemental Material, not physical scales. The location-count comparison uses Stage I, not the Stage-II continuation.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:thermo}{{2}{4}{\textbf {Two-dimensional thermodynamic reconstruction.} \textbf {(a)} Sparse exact initialization. \textbf {(b)} Exact-call allocation across Stage I and its Stage-II continuation; darker red denotes later iterations (1--34), not a phase or probability. \textbf {(c)} The 7,434-coordinate Stage-II endpoint, which contains the 6,880-coordinate Stage-I endpoint plus 554 additional exact coordinates; open symbols denote numerically flagged evaluations, not a phase. \textbf {(d)} Numerical histories; dashed lines are the saved operational references described in the Supplemental Material, not physical scales. The location-count comparison uses Stage I, not the Stage-II continuation}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Bulk topology inside the thermodynamic FFLO sector.} \textbf  {(a)} Trusted gapped FFLO observations resolved into cFFLO and tFFLO by the full-zone gap and Pfaffian invariant. \textbf  {(b)} A support-restricted contour and local opposite-$\mathbb  Z_2$ brackets locate a gap-closing region but not an exact boundary. \textbf  {(c,d)} Numerical histories and neighborhood sensitivity (Supplemental Material, Sec.\nobreakspace  {}\ref  {sm-sec:topology}).}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:topology}{{3}{5}{\textbf {Bulk topology inside the thermodynamic FFLO sector.} \textbf {(a)} Trusted gapped FFLO observations resolved into cFFLO and tFFLO by the full-zone gap and Pfaffian invariant. \textbf {(b)} A support-restricted contour and local opposite-$\mathbb Z_2$ brackets locate a gap-closing region but not an exact boundary. \textbf {(c,d)} Numerical histories and neighborhood sensitivity (Supplemental Material, Sec.~\ref {sm-sec:topology})}{figure.3}{}}
