\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Finite-domain three-dimensional exploration.} \textbf  {(a)} Exact thermodynamic observations in $(k_BT/t,J_A/t,\mu /t)$. \textbf  {(b)} Discrete trusted FFLO topology support. \textbf  {(c)} Four narrow-$\mu $ bins (centers $-0.45,0.15,0.85,1.45$, half-width 0.025) without interpolation; see Supplemental Material, Sec.\nobreakspace  {}\ref  {sm-sec:3d}. Slice populations reflect adaptive sampling and are not phase-volume estimates; the four cuts do not define a continuous topological surface.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:3d}{{4}{6}{\textbf {Finite-domain three-dimensional exploration.} \textbf {(a)} Exact thermodynamic observations in $(k_BT/t,J_A/t,\mu /t)$. \textbf {(b)} Discrete trusted FFLO topology support. \textbf {(c)} Four narrow-$\mu $ bins (centers $-0.45,0.15,0.85,1.45$, half-width 0.025) without interpolation; see Supplemental Material, Sec.~\ref {sm-sec:3d}. Slice populations reflect adaptive sampling and are not phase-volume estimates; the four cuts do not define a continuous topological surface}{figure.4}{}}
